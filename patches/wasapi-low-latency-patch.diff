From: Cheese <36419194+Cheesegle@users.noreply.github.com>
Date: Sat, 22 Aug 2026 12:00:00 -0400
Subject: feat(win): optional minimum-period WASAPI shared audio

Add a disabled-by-default WASAPILowLatencySharedMode feature for Windows.
When enabled, AudioManagerWin prefers the minimum shared-mode engine period
reported for the selected endpoint instead of the normal requested/default
buffer size.

CoreAudioUtil already queries IAudioClient3::GetSharedModeEnginePeriod() and
stores the endpoint's minimum, maximum, and default periods in the output
AudioParameters. Selecting that reported minimum also activates Chromium's
existing IAudioClient3::InitializeSharedAudioStream() path in
WASAPIAudioOutputStream, so this remains WASAPI shared mode and does not add a
new backend. Audio offload is skipped when the low-latency feature is enabled;
an explicit --audio-buffer-size remains the final user override.

No feature flag means stock selection behavior.

Enable with:
  --enable-features=WASAPILowLatencySharedMode

diff --git a/media/audio/win/audio_manager_win.cc b/media/audio/win/audio_manager_win.cc
index caa85a4d7c99e..d81388cf1c837 100644
--- a/media/audio/win/audio_manager_win.cc
+++ b/media/audio/win/audio_manager_win.cc
@@ -20,6 +20,7 @@
 #include <utility>
 
 #include "base/command_line.h"
+#include "base/feature_list.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
 #include "base/strings/string_number_conversions.h"
@@ -75,6 +76,10 @@ constexpr int kFallbackBufferSize = 2048;
 
 namespace {
 
+BASE_FEATURE(kWASAPILowLatencySharedMode,
+             "WASAPILowLatencySharedMode",
+             base::FEATURE_DISABLED_BY_DEFAULT);
+
 int NumberOfWaveOutBuffers() {
   // Use the user provided buffer count if provided.
   int buffers = 0;
@@ -343,7 +349,11 @@ AudioParameters AudioManagerWin::GetPreferredOutputStreamParameters(
   int min_buffer_size = 0;
   int max_buffer_size = 0;
   int default_buffer_size = 0;
-  bool attempt_audio_offload = CoreAudioUtil::IsAudioOffloadSupported(nullptr);
+  const bool use_low_latency_shared_mode =
+      base::FeatureList::IsEnabled(kWASAPILowLatencySharedMode);
+  const bool attempt_audio_offload =
+      !use_low_latency_shared_mode &&
+      CoreAudioUtil::IsAudioOffloadSupported(nullptr);
 
   if (cmd_line->HasSwitch(switches::kEnableExclusiveAudio)) {
     // TODO(rtoy): tune these values for best possible WebAudio
@@ -427,6 +436,13 @@ AudioParameters AudioManagerWin::GetPreferredOutputStreamParameters(
     }
   }
 
+  // CoreAudioUtil populated this value from the active endpoint through
+  // IAudioClient3::GetSharedModeEnginePeriod(). Passing it onward selects
+  // WASAPIAudioOutputStream's existing InitializeSharedAudioStream() path.
+  if (use_low_latency_shared_mode && min_buffer_size > 0) {
+    buffer_size = min_buffer_size;
+  }
+
   int user_buffer_size = GetUserBufferSize();
   if (user_buffer_size)
     buffer_size = user_buffer_size;
