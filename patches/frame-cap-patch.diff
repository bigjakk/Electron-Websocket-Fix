+// KCC: exact frame cap while --disable-frame-rate-limit is active. Paces the
+// swap-ack release that re-arms BackToBackBeginFrameSource.
+// Client passes: --enable-features=CustomFrameCap:fps/240   (0 = off)
+BASE_FEATURE(kCustomFrameCap,
+             "CustomFrameCap",
+             base::FEATURE_ENABLED_BY_DEFAULT);
+constexpr base::FeatureParam<int> kCustomFrameCapFps{&kCustomFrameCap, "fps",
+                                                     0};
+
+// Clamp 30..1000: sub-30 caps make window interactions pathological, >1000 is
+// meaningless at timer resolution.
+base::TimeDelta FrameCapIntervalFromFps(int fps) {
+  if (fps <= 0)
+    return base::TimeDelta();  // off
+  return base::Hertz(std::clamp(fps, 30, 1000));
+}
