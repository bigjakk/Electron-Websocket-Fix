 void DisplayScheduler::DidReceiveSwapBuffersAck() {
+  if (!cap_interval_.is_zero()) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    // Absolute grid with idle resync: fast acks (SWAP_SKIPPED, no-damage)
+    // must not pull frames early; idle gaps must not accumulate debt.
+    // Resync ONLY here -- never on the release path.
+    if (next_ack_release_.is_null() ||
+        now - next_ack_release_ > cap_interval_ * 4) {
+      next_ack_release_ = now;
+    }
+    // Advance the grid by whole intervals; do NOT re-anchor to |now|. Doing so
+    // would turn the grid into a per-frame floor, where a cycle can overshoot
+    // its slot but never compensate, landing the mean measurably under target.
+    next_ack_release_ += cap_interval_;
+    if (now < next_ack_release_) {
+      ++pending_release_count_;
+      if (!ack_release_timer_.IsRunning()) {
+        armed_deadline_ = next_ack_release_;
+        ack_release_timer_.Start(
+            FROM_HERE, armed_deadline_,
+            base::BindOnce(&DisplayScheduler::RunDelayedSwapBuffersAck,
+                           base::Unretained(this)),
+            base::subtle::DelayPolicy::kPrecise);
+      }
+      return;
+    }
+  }
+  DidReceiveSwapBuffersAckImpl();
+}
+
+void DisplayScheduler::RunDelayedSwapBuffersAck() {
+  if (pending_release_count_ == 0) {
+    return;  // flushed meanwhile
+  }
+  --pending_release_count_;
+  DidReceiveSwapBuffersAckImpl();
+  if (pending_release_count_ > 0) {
+    // FIFO: the next queued release fires one grid step later.
+    armed_deadline_ += cap_interval_;
+    ack_release_timer_.Start(
+        FROM_HERE, armed_deadline_,
+        base::BindOnce(&DisplayScheduler::RunDelayedSwapBuffersAck,
+                       base::Unretained(this)),
+        base::subtle::DelayPolicy::kPrecise);
+  }
+}
+
+void DisplayScheduler::FlushPendingSwapAckDelay() {
+  ack_release_timer_.Stop();
+  next_ack_release_ = base::TimeTicks();
+  // Drain the ledger COMPLETELY -- each deferred ack owes one Impl(); paying
+  // fewer corrupts pending_swaps_ and wedges the SetIsGpuBusy gate.
+  while (pending_release_count_ > 0) {
+    --pending_release_count_;
+    DidReceiveSwapBuffersAckImpl();
+  }
+}
+
+void DisplayScheduler::SetFrameCapInterval(base::TimeDelta interval) {
+  cap_interval_ = interval;
+  // New cadence starts fresh; queued releases pay out immediately (a cap
+  // change is a user action -- no re-gridding of in-flight acks).
+  FlushPendingSwapAckDelay();
+}
+
+void DisplayScheduler::DidReceiveSwapBuffersAckImpl() {
   uint32_t swap_id = next_swap_id_ - pending_swaps_;
   pending_swaps_--;
 
