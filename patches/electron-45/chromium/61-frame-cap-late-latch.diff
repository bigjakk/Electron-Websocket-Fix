@@ -328,6 +339,27 @@ void BackToBackBeginFrameSource::OnGpuNoLongerBusy() {
   OnTimerTick();
 }
 
+void BackToBackBeginFrameSource::SetFrameCapLateLatch(
+    BeginFrameObserver* scheduler_observer) {
+  frame_cap_scheduler_observer_ = scheduler_observer;
+  set_no_begin_frame_while_gpu_busy(!!scheduler_observer);
+}
+
+bool BackToBackBeginFrameSource::ShouldHoldBeginFrameUntilFrameAck() const {
+  if (!frame_cap_scheduler_observer_) {
+    return false;
+  }
+  // Only while the caller is the one frame sink being driven. Each swap takes
+  // a whole cap period, so with several sinks submitting at different times
+  // the one that comes second always finds the display busy; holding it back
+  // at the next release as well would leave every sink with half the frames.
+  // Without the hold they all start at each release and are drawn at the
+  // next, which is the stock behaviour.
+  const size_t scheduler_observers =
+      observers_.contains(frame_cap_scheduler_observer_.get()) ? 1u : 0u;
+  return observers_.size() - scheduler_observers == 1u;
+}
+
 void BackToBackBeginFrameSource::OnUpdateVSyncParameters(
     base::TimeTicks timebase,
     base::TimeDelta interval) {
@@ -374,8 +406,21 @@ void BackToBackBeginFrameSource::OnTimerTick() {
   DCHECK(!pending_observers.empty());
 
   IssueBeginFrameToInputClient(args);
-  for (BeginFrameObserver* obs : pending_observers)
-    FilterAndIssueBeginFrame(obs, args);
+  // KCC KccFrameCapLateLatch: while the latch is on, the DisplayScheduler's
+  // observer goes last, which is where IssueBeginFrameToSchedulerClient() puts
+  // the scheduler when it is a SchedulerClient. A frame sink has to be asked
+  // before the display draws the frame that sink is still waiting on; see
+  // CompositorFrameSinkSupport::OnBeginFrame().
+  BeginFrameObserver* const scheduler_observer =
+      frame_cap_scheduler_observer_.get();
+  for (BeginFrameObserver* obs : pending_observers) {
+    if (obs != scheduler_observer) {
+      FilterAndIssueBeginFrame(obs, args);
+    }
+  }
+  if (scheduler_observer && pending_observers.contains(scheduler_observer)) {
+    FilterAndIssueBeginFrame(scheduler_observer, args);
+  }
   IssueBeginFrameToSchedulerClient(args);
 }
 
