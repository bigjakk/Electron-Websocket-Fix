   switch (gpu_busy_response_state_) {
     case GpuBusyThrottlingState::kIdle:
+      if (no_begin_frame_while_gpu_busy_) {
+        // KCC KccFrameCapLateLatch: a client that got this begin-frame would
+        // render a frame that can only be drawn after the gpu stops being
+        // busy; make it start then instead.
+        gpu_busy_response_state_ = GpuBusyThrottlingState::kThrottled;
