+void DisplayScheduler::SetFrameCapLateLatchEngaged(bool engaged) {
+  if (engaged == frame_cap_late_latch_engaged_) {
+    return;
+  }
+  frame_cap_late_latch_engaged_ = engaged;
+  begin_frame_source_->SetFrameCapLateLatch(engaged ? &begin_frame_observer_
+                                                    : nullptr);
+}
+
+void DisplayScheduler::MaybeEngageFrameCapLateLatch() {
+  // Once engaged it stays engaged for as long as swap acks are being held
+  // back; DidReceiveSwapBuffersAck() disengages it.
+  if (!IsFrameCapLateLatchEnabled() || frame_cap_late_latch_engaged_) {
+    return;
+  }
+  // In the stock order a frame is waiting to be drawn at this release.
+  if (!needs_draw_ || undrawn_damage_since_.is_null() ||
+      held_ack_arrival_.is_null()) {
+    return;
+  }
+  // That frame was started at the previous release and has waited since
+  // |undrawn_damage_since_|; the ack of the previous swap has waited since
+  // |held_ack_arrival_|. Had the frame been drawn as soon as it arrived, the
+  // ack of its swap would have been held for the sum of the two waits less one
+  // cap period: the slack the client leaves without pipelining.
+  static const int slack_pct =
+      std::clamp(kKccFrameCapLateLatchSlackPct.Get(), 0, 90);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeDelta slack = (now - held_ack_arrival_) +
+                                (now - undrawn_damage_since_) - cap_interval_;
+  if (slack >= cap_interval_ * slack_pct / 100) {
+    SetFrameCapLateLatchEngaged(true);
+  }
+}
+
 void DisplayScheduler::FlushPendingSwapAckDelay() {
   StopAckReleaseTimer();
   next_ack_release_ = base::TimeTicks();
