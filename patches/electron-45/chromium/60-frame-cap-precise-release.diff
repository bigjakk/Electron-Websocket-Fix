+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_FRAME_CAP_PRECISE_TIMER_WIN_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_FRAME_CAP_PRECISE_TIMER_WIN_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "base/win/object_watcher.h"
+#include "base/win/scoped_handle.h"
+
+namespace viz {
+
+// KCC KccFrameCapPreciseRelease. Runs a callback on the current sequence at an
+// absolute base::TimeTicks with sub-millisecond accuracy.
+//
+// A delayed task cannot do that on Windows: the message pump waits with a
+// whole-millisecond timeout and wakes on the system clock tick. This uses a
+// high-resolution waitable timer (Windows 10 1803+) instead, watched from the
+// thread pool so that the calling thread is never blocked. The kernel expires
+// such a timer on the first clock tick at or after its due time, with the clock
+// temporarily running at its maximum rate (0.5 ms on most hardware), so the
+// timer is armed |max_spin| ahead of the deadline and the remainder, if any, is
+// spent spinning on the calling thread.
+//
+// All methods must be called on the sequence that called Create().
+class FrameCapPreciseTimerWin : public base::win::ObjectWatcher::Delegate {
+ public:
+  // Returns null if the timer cannot be created or watched. |on_fire| is run at
+  // most once per Start() and may call Start() or Stop().
+  static std::unique_ptr<FrameCapPreciseTimerWin> Create(
+      base::RepeatingClosure on_fire,
+      base::TimeDelta max_spin);
+
+  FrameCapPreciseTimerWin(const FrameCapPreciseTimerWin&) = delete;
+  FrameCapPreciseTimerWin& operator=(const FrameCapPreciseTimerWin&) = delete;
+
+  ~FrameCapPreciseTimerWin() override;
+
+  // Schedules |on_fire| for |deadline|, replacing any earlier schedule. Returns
+  // false, with nothing scheduled, if the OS timer could not be set.
+  bool Start(base::TimeTicks deadline);
+
+  // Cancels the schedule, if any. |on_fire| will not run until the next
+  // Start().
+  void Stop();
+
+  bool IsRunning() const { return armed_; }
+
+ private:
+  FrameCapPreciseTimerWin(base::win::ScopedHandle timer,
+                          base::RepeatingClosure on_fire,
+                          base::TimeDelta max_spin);
+
+  // Sets the OS timer to expire |max_spin_| before |deadline_|.
+  bool Arm();
+
+  // base::win::ObjectWatcher::Delegate:
+  void OnObjectSignaled(HANDLE object) override;
+
+  const base::RepeatingClosure on_fire_;
+  const base::TimeDelta max_spin_;
+
+  base::TimeTicks deadline_;
+  bool armed_ = false;
+
+  // |watcher_| is declared after |timer_| so that it stops watching the handle
+  // before the handle is closed.
+  base::win::ScopedHandle timer_;
+  base::win::ObjectWatcher watcher_;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_FRAME_CAP_PRECISE_TIMER_WIN_H_
