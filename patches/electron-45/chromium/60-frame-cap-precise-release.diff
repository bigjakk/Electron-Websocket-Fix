new file mode 100644
index 0000000000000000000000000000000000000000..4bc42510500a8f27c224ee6bbe7c1b2dd79db8ac
--- /dev/null
+++ b/components/viz/service/display/frame_cap_precise_timer_win.cc
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/viz/service/display/frame_cap_precise_timer_win.h"
+
+#include <windows.h>
+
+#include <stdint.h>
+
+#include <algorithm>
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "base/task/sequenced_task_runner.h"
+
+// Defined by the Windows SDK since 10.0.17134.
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+namespace viz {
+
+// static
+std::unique_ptr<FrameCapPreciseTimerWin> FrameCapPreciseTimerWin::Create(
+    base::RepeatingClosure on_fire,
+    base::TimeDelta max_spin) {
+  // The watcher posts its notifications to the current sequence.
+  if (!base::SequencedTaskRunner::HasCurrentDefault()) {
+    return nullptr;
+  }
+
+  // No CREATE_WAITABLE_TIMER_MANUAL_RESET: the wait that observes an expiry
+  // must also consume it, or a watcher that stays registered would be notified
+  // forever. Fails on Windows versions without high-resolution timers.
+  base::win::ScopedHandle timer(::CreateWaitableTimerExW(
+      nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+      TIMER_ALL_ACCESS));
+  if (!timer.is_valid()) {
+    return nullptr;
+  }
+
+  auto precise_timer = base::WrapUnique(new FrameCapPreciseTimerWin(
+      std::move(timer), std::move(on_fire), max_spin));
+  // Registered once for the lifetime of the timer: starting and stopping a
+  // watch costs a blocking round trip to the thread pool, which is too much to
+  // pay on every frame.
+  if (!precise_timer->watcher_.StartWatchingMultipleTimes(
+          precise_timer->timer_.get(), precise_timer.get())) {
+    return nullptr;
+  }
+  return precise_timer;
+}
+
+FrameCapPreciseTimerWin::FrameCapPreciseTimerWin(base::win::ScopedHandle timer,
+                                                 base::RepeatingClosure on_fire,
+                                                 base::TimeDelta max_spin)
+    : on_fire_(std::move(on_fire)),
+      max_spin_(max_spin),
+      timer_(std::move(timer)) {}
+
+FrameCapPreciseTimerWin::~FrameCapPreciseTimerWin() = default;
+
+bool FrameCapPreciseTimerWin::Start(base::TimeTicks deadline) {
+  deadline_ = deadline;
+  armed_ = Arm();
+  return armed_;
+}
+
+void FrameCapPreciseTimerWin::Stop() {
+  if (!armed_) {
+    return;
+  }
+  armed_ = false;
+  // An expiry that the watcher has already picked up still arrives as a
+  // notification; OnObjectSignaled() drops it.
+  ::CancelWaitableTimer(timer_.get());
+}
+
+bool FrameCapPreciseTimerWin::Arm() {
+  // A negative due time is relative, in 100 ns units. Relative rather than
+  // absolute because absolute due times are wall-clock times. Rounded up so
+  // that the timer is never due before the time asked for, and at least one
+  // unit because zero would be read as an absolute time. Setting the timer
+  // also resets its signaled state and replaces any pending expiry.
+  const base::TimeDelta delay =
+      deadline_ - max_spin_ - base::TimeTicks::Now();
+  LARGE_INTEGER due_time;
+  due_time.QuadPart =
+      -std::max<int64_t>((delay.InMicroseconds() + 1) * 10, 1);
+  return ::SetWaitableTimer(timer_.get(), &due_time, 0, nullptr, nullptr,
+                            FALSE) != 0;
+}
+
+void FrameCapPreciseTimerWin::OnObjectSignaled(HANDLE object) {
+  // Notifications are posted from the thread pool, so one can arrive after
+  // Stop(), or after a later Start() than the one it belongs to. They are
+  // therefore only a hint to look at the clock: |armed_| and |deadline_| decide
+  // what happens.
+  if (!armed_) {
+    return;
+  }
+
+  if (deadline_ - base::TimeTicks::Now() > max_spin_) {
+    // Too early to belong to the current schedule. Wait out the rest, unless
+    // the timer cannot be set, in which case running the callback early is
+    // better than never running it.
+    if (Arm()) {
+      return;
+    }
+  } else {
+    while (base::TimeTicks::Now() < deadline_) {
+      // Spin: at most |max_spin_|, checked above.
+    }
+  }
+
+  armed_ = false;
+  on_fire_.Run();
+  // |this| may have been deleted by |on_fire_|.
+}
+
+}  // namespace viz
