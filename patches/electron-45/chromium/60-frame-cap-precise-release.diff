 void BackToBackBeginFrameSource::OnGpuNoLongerBusy() {
+  if (tick_parked_) {
+    // KCC KccFrameCapPreciseRelease: |time_source_| forgot its tick time when
+    // it was stopped, so OnTimerTick() cannot run inline here as it does below.
+    // Restart the time source and let it deliver the tick; it may already be
+    // running again if an observer was added or finished a frame meanwhile.
+    tick_parked_ = false;
+    if (!pending_begin_frame_observers_.empty()) {
+      time_source_->SetActive(true);
+    }
+    return;
+  }
   OnTimerTick();
 }
 
@@ -333,8 +344,17 @@ void BackToBackBeginFrameSource::SetMaxVrrInterval(
 }
 
 void BackToBackBeginFrameSource::OnTimerTick() {
-  if (RequestCallbackOnGpuAvailable())
+  if (RequestCallbackOnGpuAvailable()) {
+    // KCC KccFrameCapPreciseRelease: |time_source_| has a zero interval, so by
+    // now it has already posted the next tick, which would be dropped right
+    // here as well: the thread never goes idle while the gpu is busy. Stop the
+    // time source instead; OnGpuNoLongerBusy() restarts it.
+    if (park_throttled_begin_frames()) {
+      tick_parked_ = true;
+      time_source_->SetActive(false);
+    }
     return;
+  }
   if (!time_source_->Active()) {
     return;
   }
