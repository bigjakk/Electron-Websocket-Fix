@@ -247,6 +251,22 @@ void CommandBufferStub::ScheduleDelayedWork(base::TimeDelta delay) {
     return;
   }
 
+#if BUILDFLAG(IS_MAC)
+  // KCC (KccMacFineGpuBackpressure): the command buffer is unscheduled only
+  // between OnDescheduleUntilFinished() and OnRescheduleAfterFinished(), i.e.
+  // while WebGL back-pressure waits for the previous frame's fence, and this
+  // timer is the only thing that notices the fence completing. Scale the
+  // upstream 2 ms (first poll) / 1 ms (repeat) delays so that the 1 ms one
+  // becomes the configured period. Nothing else is affected.
+  if (!command_buffer_->scheduled()) {
+    const base::TimeDelta poll_period =
+        features::KccMacFineGpuBackpressurePollPeriod();
+    if (!poll_period.is_zero()) {
+      delay = poll_period * delay.InMillisecondsF();
+    }
+  }
+#endif  // BUILDFLAG(IS_MAC)
