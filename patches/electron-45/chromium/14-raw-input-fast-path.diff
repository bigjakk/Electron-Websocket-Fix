   }
-  DCHECK_EQ(size, result);
 
   if (input->header.dwType == RIM_TYPEMOUSE &&
       (input->data.mouse.usButtonFlags != RI_MOUSE_WHEEL ||
@@ -3503,6 +3532,21 @@ LRESULT HWNDMessageHandler::HandleMouseEventInternal(UINT message,
     }
   }
 
+  // kcc: while raw input is in use a legacy WM_MOUSEMOVE is always dropped by
+  // the |using_wm_input_| check further down. Drop it here instead, before a
+  // ui::MouseEvent is built for it. The one thing the stock path does for such
+  // a message before dropping it, starting WM_MOUSELEAVE tracking, is kept.
+  if (using_wm_input_ && message == WM_MOUSEMOVE && RawInputFastPathEnabled()) {
+    // As in ui::EventTypeFromMSG(): with a button down the message is an
+    // EventType::kMouseDragged, which does not start tracking.
+    const bool is_drag = (w_param & (MK_LBUTTON | MK_MBUTTON | MK_RBUTTON |
+                                     MK_XBUTTON1 | MK_XBUTTON2)) != 0;
+    if (!is_drag && track_mouse && !HasCapture()) {
+      TrackMouseEvents(TME_LEAVE);
+    }
+    return 0;
+  }
