+std::unique_ptr<aura::ScopedEnableUnadjustedMouseEvents>
+DesktopWindowTreeHostLinux::RequestUnadjustedMovement() {
+  // kcc: only X11 windows have an X11Extension, and only X11Window implements
+  // SetRawMouseMotionEnabled().
+  if (base::FeatureList::IsEnabled(kKccX11RawMouse)) {
+    auto* x11_extension = GetX11Extension();
+    if (x11_extension && x11_extension->SetRawMouseMotionEnabled(true)) {
+      // The host can be destroyed before the object that holds the returned
+      // scoper, hence the weak pointer.
+      return std::make_unique<ScopedEnableUnadjustedMouseEventsX11>(
+          base::BindOnce(&DesktopWindowTreeHostLinux::StopUnadjustedMovement,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
+  return DesktopWindowTreeHostPlatform::RequestUnadjustedMovement();
+}
+
+void DesktopWindowTreeHostLinux::StopUnadjustedMovement() {
+  if (auto* x11_extension = GetX11Extension()) {
