+bool DeviceDataManagerX11::GetRawMotionDelta(
+    const x11::Input::RawDeviceEvent& raw,
+    double* dx,
+    double* dy) const {
+  if (raw.opcode != x11::Input::RawDeviceEvent::RawMotion) {
+    return false;
+  }
+  // The server processes every event of a slave device a second time for the
+  // master pointer the slave is attached to. Count only that second copy, so
+  // that one physical motion is never reported twice.
+  if (std::ranges::find(master_pointers_, raw.deviceid) ==
+      master_pointers_.end()) {
+    return false;
+  }
+  if (absolute_pointer_devices_.contains(raw.sourceid)) {
+    return false;
+  }
+
+  // |axisvalues_raw| has one entry for each bit set in |valuator_mask|, in
+  // valuator order, so X (valuator 0) and Y (valuator 1) come first when they
+  // are present. Higher valuators (scroll wheels) are ignored.
+  const auto mask = base::as_byte_span(raw.valuator_mask);
+  const bool has_x = IsXinputMaskSet(mask, 0);
+  const bool has_y = IsXinputMaskSet(mask, 1);
+  const size_t count = (has_x ? 1u : 0u) + (has_y ? 1u : 0u);
+  if (count == 0 || raw.axisvalues_raw.size() < count) {
+    return false;
+  }
+  *dx = has_x ? Fp3232ToDouble(raw.axisvalues_raw[0]) : 0.0;
+  *dy = has_y ? Fp3232ToDouble(raw.axisvalues_raw[count - 1]) : 0.0;
+  return true;
+}
