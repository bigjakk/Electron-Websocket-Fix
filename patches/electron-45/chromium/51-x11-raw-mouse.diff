+void X11Window::OnRawMouseMotion(double dx, double dy, int source_device_id) {
+  raw_mouse_motion_seen_ = true;
+
+  // The server reports raw motion whichever window the pointer is over,
+  // whichever application has the focus and whoever has grabbed the pointer.
+  // Only pass it on while this window holds the capture that pointer lock
+  // takes AND has the input focus, so that movement made while the user is in
+  // another application can never reach the page. (Pointer lock is dropped on
+  // blur, which ends raw mode; this check covers the time in between and any
+  // path on which that does not happen.)
+  if (!HasCapture() || !IsActive()) {
+    raw_mouse_motion_remainder_x_ = 0.0;
+    raw_mouse_motion_remainder_y_ = 0.0;
+    return;
+  }
+
+  // The movement of a mouse event ends up in integer fields of
+  // blink::WebMouseEvent. Raw deltas can be fractional, so dispatch the whole
+  // part and keep the fraction for the next event instead of losing it.
+  raw_mouse_motion_remainder_x_ += dx;
+  raw_mouse_motion_remainder_y_ += dy;
+  const double whole_x = std::trunc(raw_mouse_motion_remainder_x_);
+  const double whole_y = std::trunc(raw_mouse_motion_remainder_y_);
+  if (whole_x == 0.0 && whole_y == 0.0) {
+    return;
+  }
+  raw_mouse_motion_remainder_x_ -= whole_x;
+  raw_mouse_motion_remainder_y_ -= whole_y;
+
+  // Like HWNDMessageHandler::OnInputEvent() on Windows: a mouse move that
+  // carries the current modifier and button state and the raw delta as its
+  // movement. Raw motion has no position. The centre of the window is
+  // reported, which is where PreHandleMouseEventForRawMotion() keeps the
+  // pointer.
+  const gfx::PointF location(
+      gfx::Rect(GetBoundsInPixels().size()).CenterPoint());
+  MouseEvent event(EventType::kMouseMoved, location, location,
+                   EventTimeForNow(), raw_mouse_event_flags_, 0);
+  event.set_source_device_id(source_device_id);
+  MouseEvent::DispatcherApi(&event).set_movement(gfx::Vector2dF(
+      static_cast<float>(whole_x), static_cast<float>(whole_y)));
+  DispatchEventFromNativeUiEvent(
+      &event, base::BindOnce(&PlatformWindowDelegate::DispatchEvent,
+                             base::Unretained(platform_window_delegate())));
+}
+
+bool X11Window::PreHandleMouseEventForRawMotion(const MouseEvent& event) {
+  // Button events keep their button in flags(), a release included.
+  raw_mouse_event_flags_ = event.flags() & kRawMouseMotionStateFlags;
+  if (event.type() == EventType::kMouseReleased) {
+    raw_mouse_event_flags_ &= ~event.changed_button_flags();
+  }
+
+  if (event.type() != EventType::kMouseMoved &&
+      event.type() != EventType::kMouseDragged) {
+    return false;
+  }
+  // Keep ordinary mouse moves while they are the only source of movement:
+  // before the first raw motion has arrived (it never does for a pointer with
+  // absolute axes, or under XWayland when the Wayland compositor has no
+  // relative pointer protocol), and whenever this window does not hold the
+  // capture or the input focus (raw motion is not forwarded then, see
+  // OnRawMouseMotion()).
+  if (!raw_mouse_motion_seen_ || !HasCapture() || !IsActive()) {
+    return false;
+  }
+
+  // The delegate no longer learns where the pointer is, so it can not move it
+  // back when it gets close to the edge of the window. Do that here: keep the
+  // hidden pointer in the middle of the window, so that button events stay
+  // inside the window and XWayland keeps emulating the pointer lock. The
+  // warp produces an ordinary motion event (dropped here like the others) but
+  // no raw motion.
+  const gfx::Rect bounds(GetBoundsInPixels().size());
+  const gfx::Vector2d offset = event.location() - bounds.CenterPoint();
+  if (std::abs(offset.x()) > bounds.width() / 4 ||
+      std::abs(offset.y()) > bounds.height() / 4) {
+    MoveCursorTo(bounds.CenterPoint());
+  }
+  return true;
+}
