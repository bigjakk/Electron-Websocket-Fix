+bool X11Window::SetRawMouseMotionEnabled(bool enabled) {
+  if (enabled == raw_mouse_motion_enabled_) {
+    return true;
+  }
+  if (enabled && (xwindow_ == x11::Window::None || !IsXInput2Available())) {
+    return false;
+  }
+  raw_mouse_motion_enabled_ = enabled;
+  raw_mouse_motion_seen_ = false;
+  raw_mouse_motion_remainder_x_ = 0.0;
+  raw_mouse_motion_remainder_y_ = 0.0;
+  // The server queues a motion's raw event before its core event, so with a
+  // lock taken from a mousedown the first raw move would go out before any
+  // ordinary mouse event has set the button and modifier state. Start from the
+  // pointer's state instead (one synchronous QueryPointer).
+  raw_mouse_event_flags_ =
+      enabled ? ui::XGetMaskAsEventFlags() & kRawMouseMotionStateFlags : 0;
+
+  if (enabled) {
+    ++g_raw_mouse_motion_users;
+  } else {
+    --g_raw_mouse_motion_users;
+  }
+  // XI_RawMotion is only delivered to clients that select it on the root
+  // window. Select it when the first window starts and deselect it when the
+  // last one stops. Selecting for the master devices gives one event per
+  // physical motion, and does not disturb the mask DeviceDataManagerX11 keeps
+  // on the root window for DeviceId::All.
+  if (g_raw_mouse_motion_users == (enabled ? 1 : 0)) {
+    const x11::Input::XIEventMask mask =
+        enabled ? x11::Input::XIEventMask::RawMotion
+                : x11::Input::XIEventMask{};
+    connection_->xinput().XISelectEvents(
+        {x_root_window_, {{x11::Input::DeviceId::AllMaster, {mask}}}});
+    connection_->Flush();
+  }
+  return true;
+}
