@@ -159,6 +159,10 @@ class PannerHandler final : public AudioHandler {
 
   scoped_refptr<AudioListenerHandler> listener_handler_;
 
+  // KCC: state of the KccHrtfPannerKRateAngles feature, read once on the main
+  // thread so that the audio thread does not have to query the feature list.
+  const bool kcc_hrtf_k_rate_angles_;
+
   // Sample-accurate value arrays for PannerHandler.
   AudioFloatArray panner_x_values_;
   AudioFloatArray panner_y_values_;
